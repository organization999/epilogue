include LICENSE
include README.md
include pyproject.toml
include setup.py

recursive-include buildsystem *.py
recursive-include docs *.md
recursive-include examples *.py
recursive-include include *.hpp *.inl
recursive-include source *.cc
recursive-include tests *.cc *.hpp *.py
recursive-include v12 *.py *.pyi py.typed
recursive-include vendor/v12/include *.hpp *.inl

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.pyd
global-exclude *.so
global-exclude *.dll
