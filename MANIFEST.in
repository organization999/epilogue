include LICENSE
include README.md
include pyproject.toml
include setup.py

recursive-include buildsystem *.py
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include epilogue *.py *.pyi py.typed

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.pyd
global-exclude *.so
global-exclude *.dll
